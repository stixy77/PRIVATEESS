    local suffixes = {
        {1e15, "Qa"}, {1e12, "T"}, {1e9, "B"}, {1e6, "M"}, {1e3, "K"}
    }
    for _, suffix in ipairs(suffixes) do
        if math.abs(number) >= suffix[1] then
            return string.format("%.2f%s", number / suffix[1], suffix[2])
        end
    end
    return tostring(math.floor(number))
