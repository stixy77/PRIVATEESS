AutoFarm:AddSwitch("Hide All Frames", function(state)
    local player = game:GetService("Players").LocalPlayer
    local pGui = player:FindFirstChild("PlayerGui")

    if not pGui then return end

    -- Función para ocultar/mostrar objetos en la pantalla
    local function toggleFrames(parent, isHidden)
        for _, obj in pairs(parent:GetDescendants()) do
            if obj:IsA("GuiObject") and obj.Name:match("Frame$") then
                obj.Visible = not isHidden
            end
        end
    end

    -- Aplicar a los elementos actuales en pantalla
    toggleFrames(pGui, state)

    if state then
        -- Desconectar conexión previa si existía
        if _G.HideFramesConn then
            _G.HideFramesConn:Disconnect()
        end
        
        -- Ocultar automáticamente cualquier nuevo Frame que el juego clone en pantalla
        _G.HideFramesConn = pGui.DescendantAdded:Connect(function(obj)
            if obj:IsA("GuiObject") and obj.Name:match("Frame$") then
                obj.Visible = false
            end
        end)
    else
        -- Restaurar visibilidad
        if _G.HideFramesConn then
            _G.HideFramesConn:Disconnect()
            _G.HideFramesConn = nil
        end
    end
end)

