local function eatProteinEgg()
    local player = game.Players.LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()
    local backpack = player:FindFirstChild("Backpack")
    local muscleEvent = player:FindFirstChild("muscleEvent")

    if not backpack or not muscleEvent then return end

    -- Busca el huevo en la mochila o si ya está equipado
    local egg = backpack:FindFirstChild("Protein Egg") or character:FindFirstChild("Protein Egg")

    if egg then
        -- Equipar el ítem si aún está en la mochila
        if egg.Parent ~= character then
            egg.Parent = character
            task.wait(0.2)
        end

        -- Envía la petición directamente a muscleEvent evitando el cuadro flotante de confirmación (UI)
        pcall(function()
            muscleEvent:FireServer("proteinEgg", egg)
        end)
    end
end

